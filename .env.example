# local | staging | production. Sin credenciales la web funciona y el admin se bloquea.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# La integración de catálogo, administración y comercio usa publishable + sesión + RLS.
# No se necesita una clave secret ni service_role.
# No agregar credenciales de pagos ni correo hasta sus fases correspondientes.
